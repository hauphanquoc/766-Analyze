  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Tu dong lay Cookie WAF tu trang goc dichvucong.gov.vn",
          "const lastFetch = pm.collectionVariables.get(\"last_cookie_time\");",
          "const now = Date.now();",
          "if (!pm.collectionVariables.get(\"dvc_cookie\") || !lastFetch || (now - Number(lastFetch) > 600000)) {",
          "    pm.sendRequest({",
          "        url: \"https://dichvucong.gov.vn/danh-gia-chat-luong-phuc-vu\",",
          "        method: \"GET\",",
          "        header: {",
          "            \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36\"",
          "        }",
          "    }, function (err, res) {",
          "        if (!err && res) {",
          "            const setCookies = res.headers.filter(h => h.key.toLowerCase() === \"set-cookie\");",
          "            const cookieStr = setCookies.map(h => h.value.split(\";\")[0]).join(\"; \");",
          "            if (cookieStr) {",
          "                pm.collectionVariables.set(\"dvc_cookie\", cookieStr);",
          "                pm.collectionVariables.set(\"last_cookie_time\", now);",
          "                console.log(\"[Anti-WAF] Da lay cookie WAF moi thanh cong:\", cookieStr);",
          "            }",
          "        }",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "dvc_cookie",
      "value": ""
    },
    {
      "key": "last_cookie_time",
      "value": "0"
    }
  ]
