{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "data/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 23 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/cron",
      "dest": "/api/cron.js"
    },
    {
      "src": "/api/crawl",
      "dest": "/api/crawl.js"
    },
    {
      "src": "/api/test-fetch",
      "dest": "/api/test-fetch.js"
    },
    {
      "src": "/api/data",
      "dest": "/api/data.js"
    },
    {
      "src": "/api/export",
      "dest": "/api/export.js"
    },
    {
      "src": "/api/provinces",
      "dest": "/api/provinces.js"
    },
    {
      "src": "/api/auth",
      "dest": "/api/auth.js"
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/auth.js?action=$1"
    },
    {
      "src": "/api/users",
      "dest": "/api/users.js"
    },
    {
      "src": "/api/users/(.*)",
      "dest": "/api/users.js?action=$1"
    },
    {
      "src": "/766donvi",
      "dest": "/api/766donvi.js"
    },
    {
      "src": "/766donvi/(.*)",
      "dest": "/api/766donvi.js?code=$1"
    },
    {
      "src": "/api/766donvi",
      "dest": "/api/766donvi.js"
    },
    {
      "src": "/api/766donvi/(.*)",
      "dest": "/api/766donvi.js?code=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?!_vercel/)(.*)",
      "dest": "/public/$1"
    }
  ]
}
