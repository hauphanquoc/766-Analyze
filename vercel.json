{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/cron",
      "dest": "/api/cron.js"
    },
    {
      "src": "/api/crawl",
      "dest": "/api/crawl.js"
    },
    {
      "src": "/api/test-fetch",
      "dest": "/api/test-fetch.js"
    },
    {
      "src": "/api/data",
      "dest": "/api/data.js"
    },
    {
      "src": "/api/export",
      "dest": "/api/export.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?!_vercel/)(.*)",
      "dest": "/public/$1"
    }
  ]
}
